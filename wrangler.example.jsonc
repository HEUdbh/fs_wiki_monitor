{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "feishu-wiki-monitor",
  "compatibility_date": "2025-08-03",
  "main": "./src/index.ts",
  "workers_dev": true,
  "kv_namespaces": [
    {
      "binding": "FEISHU_MONITOR_KV",
      "id": "REPLACE_WITH_PRODUCTION_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_PREVIEW_KV_NAMESPACE_ID"
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "triggers": {
    "crons": [
      "0,30 1-13 * * *",
      "0 14 * * *",
      "30 14 * * *"
    ]
  },
  "vars": {
    "APP_ORIGIN": "https://REPLACE_WITH_YOUR_WORKER_DOMAIN",
    "FEISHU_API_BASE_URL": "https://open.feishu.cn",
    "FEISHU_ACCOUNTS_BASE_URL": "https://accounts.feishu.cn",
    "SESSION_TTL_SECONDS": "604800",
    "MONITOR_LOCK_TTL_SECONDS": "600"
  }
}
